generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// TABEL BARU: Data Penyewa (Tenant)
model Company {
  id               String    @id @default(uuid())
  nama_perusahaan  String
  jenis_klien      String    @default("Perusahaan")
  kontak_wa        String?
  masa_sewa_habis  DateTime?
  status_aktif     Boolean   @default(true)
  app_name         String?   @default("Centra Work")
  app_icon         String?   @db.LongText            
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  users            User[]
  roles            Role[]
  tasks            Task[]
  notifications    Notification[]
  default_tasks    DefaultTask[]
  audit_logs       AuditLog[]
}

// 1. Tabel Master Hak Akses
model Role {
  id          Int      @id @default(autoincrement())
  nama_role   String
  level_akses Int
  company_id  String?  // Null berarti Divisi Inti Bawaan Sistem
  
  company     Company? @relation(fields: [company_id], references: [id], onDelete: Cascade)
  users       User[]
}

// 2. Tabel Data Karyawan/Pengguna
model User {
  id                String             @id @default(uuid())
  role_id           Int
  company_id        String?            // Null berarti akun Manajemen (Pemilik SaaS)
  nama_lengkap      String
  email             String             @unique
  password          String             
  foto_profil       String?            @db.LongText
  status_aktif      Boolean            @default(true)
  created_at        DateTime           @default(now())
  
  company           Company?           @relation(fields: [company_id], references: [id], onDelete: Cascade)
  role              Role               @relation(fields: [role_id], references: [id])
  tasks_created     Task[]             @relation("PembuatTugas")
  tasks_assigned    TaskAssignment[]
  notifications     Notification[]     @relation("PengirimNotif")
  audit_logs        AuditLog[]
  user_notifications UserNotification[]
}

// 3. Tabel Data Induk Tugas
model Task {
  id              String             @id @default(uuid())
  company_id      String?
  pembuat_id      String?
  judul_tugas     String
  deskripsi       String?            @db.Text
  jenis_tugas     String             
  tenggat_waktu   DateTime?
  poin            Int                @default(10)
  created_at      DateTime           @default(now())
  
  company         Company?           @relation(fields: [company_id], references: [id], onDelete: Cascade)
  pembuat         User?              @relation("PembuatTugas", fields: [pembuat_id], references: [id])
  assignments     TaskAssignment[]
}

// 4. Tabel Pivot/Penerima Tugas
model TaskAssignment {
  id                String    @id @default(uuid())
  task_id           String
  penerima_id       String
  status            String    @default("Pending") 
  diselesaikan_pada DateTime?
  laporan           String?   @db.Text
  foto_bukti        String?   @db.LongText
  
  task              Task      @relation(fields: [task_id], references: [id], onDelete: Cascade)
  penerima          User      @relation(fields: [penerima_id], references: [id], onDelete: Cascade)
}

// 5. Tabel Data Induk Notifikasi
model Notification {
  id               String             @id @default(uuid())
  company_id       String?
  pengirim_id      String?
  judul_notifikasi String
  isi_pesan        String             @db.Text
  created_at       DateTime           @default(now())
  
  company          Company?           @relation(fields: [company_id], references: [id], onDelete: Cascade)
  pengirim         User?              @relation("PengirimNotif", fields: [pengirim_id], references: [id], onDelete: SetNull)
  receivers        UserNotification[]
}

// 6. Tabel Pivot Penerima Notifikasi
model UserNotification {
  id              String       @id @default(uuid())
  notification_id String
  penerima_id     String
  is_read         Boolean      @default(false)
  
  notification    Notification @relation(fields: [notification_id], references: [id], onDelete: Cascade)
  penerima        User         @relation(fields: [penerima_id], references: [id], onDelete: Cascade)
}

// 7. Tabel Tugas Rutin (Default)
model DefaultTask {
  id             String   @id @default(uuid())
  company_id     String?
  judul_tugas    String
  deskripsi      String?  @db.Text
  target_role_id Int
  jam_tenggat    String?
  status_aktif   Boolean  @default(true)
  created_at     DateTime @default(now())
  
  company        Company? @relation(fields: [company_id], references: [id], onDelete: Cascade)
}

// 8. Tabel Log Aktivitas (Audit Trail)
model AuditLog {
  id         String   @id @default(uuid())
  company_id String?
  user_id    String
  aktor      String   
  aksi       String   
  detail     String   @db.Text 
  waktu      DateTime @default(now())
  
  company    Company? @relation(fields: [company_id], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}